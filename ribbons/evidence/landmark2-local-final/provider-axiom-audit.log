  Q.probeQuiver =
    {
      source := fun x =>
        match x with
        | Sum.inl a => Sum.inl (Q.source a)
        | Sum.inr (v, b, dir) => if dir = true then Sum.inr (v, b) else Sum.inl v,
      target := fun x =>
        match x with
        | Sum.inl a => Sum.inl (Q.target a)
        | Sum.inr (v, b, dir) => if dir = true then Sum.inl v else Sum.inr (v, b),
      reverse :=
        {
          toFun := fun a =>
            match a with
            | Sum.inl a => Sum.inl (Q.reverse a)
            | Sum.inr (v, b, dir) => Sum.inr (v, b, !dir),
          invFun := fun a =>
            match a with
            | Sum.inl a => Sum.inl (Q.reverse a)
            | Sum.inr (v, b, dir) => Sum.inr (v, b, !dir),
          left_inv := ⋯, right_inv := ⋯ },
      reverse_reverse := ⋯, source_reverse := ⋯, target_reverse := ⋯ }
