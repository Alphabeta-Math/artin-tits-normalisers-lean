  (T : Set S) (hT : OAI.HarmonicArtin.IsSpherical M T) :
  Function.Injective ⇑(OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T))
OAI.HarmonicArtin.spherical_positive_monoid_fractions {S : Type} [Fintype S] (M : CoxeterMatrix S) (T : Set S)
  (hT : OAI.HarmonicArtin.IsSpherical M T)
  (g : OAI.HarmonicArtin.Artin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) :
  (∃ a b,
      g =
        (OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) a *
          ((OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) b)⁻¹) ∧
    ∃ c d,
      g =
        ((OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) c)⁻¹ *
          (OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) d
