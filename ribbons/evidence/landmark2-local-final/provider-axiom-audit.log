OAI.HarmonicArtin.positivePrefix_simple_iff.{u_1} {S : Type u_1} (M : CoxeterMatrix S) [Fintype S] (u v : M.Group) :
  OAI.HarmonicArtin.PositivePrefix M (OAI.HarmonicArtin.positiveSimpleLift M u)
      (OAI.HarmonicArtin.positiveSimpleLift M v) ↔
    OAI.HarmonicArtin.CoxeterExchange.WeakPrefix M.toCoxeterSystem u v
OAI.HarmonicArtin.positive_longest_descent_prefix.{u_1} {S : Type u_1} [Fintype S] (M : CoxeterMatrix S) (J : Set S)
  (w : M.Group) (hJ : ∀ s ∈ J, M.toCoxeterSystem.length (M.toCoxeterSystem.simple s * w) < M.toCoxeterSystem.length w) :
  ∃ q,
    (∀ (r : (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M J).Group),
        (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M J).toCoxeterSystem.length r ≤
          (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M J).toCoxeterSystem.length q) ∧
      OAI.HarmonicArtin.PositivePrefix M
        (OAI.HarmonicArtin.positiveSimpleLift M ((OAI.HarmonicArtin.CoxeterExchange.restrictionHom M J) q))
        (OAI.HarmonicArtin.positiveSimpleLift M w)
