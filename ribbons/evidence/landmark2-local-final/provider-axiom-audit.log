OAI.HarmonicArtin.spherical_positive_lcm_left {S : Type} [Fintype S] [LinearOrder S] (M : CoxeterMatrix S) (T : Set S)
  (hT : OAI.HarmonicArtin.IsSpherical M T)
  (a b : OAI.HarmonicArtin.PositiveArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)) :
