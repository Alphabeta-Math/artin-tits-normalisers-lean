OAI.HarmonicArtin.spherical_positiveToAmbient_injective {S : Type} [Fintype S] [LinearOrder S] (M : CoxeterMatrix S)
  (T : Set S) (hT : OAI.HarmonicArtin.IsSpherical M T) :
  Function.Injective
    ⇑((OAI.HarmonicArtin.restrictedArtinHom M T).comp
        (OAI.HarmonicArtin.positiveToArtin (OAI.HarmonicArtin.CoxeterExchange.restrictedMatrix M T)))
