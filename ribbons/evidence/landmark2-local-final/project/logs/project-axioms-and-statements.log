PROJECT_TYPE ArtinRibbons.ParabolicReduction ArtinNormalisers.Ribbon2.exists_positive_parabolic_double_reduction._proof_1_2: ∀
  {I : Type u_1} (M : CoxeterMatrix I) (J : Set I) (p : ArtinNormalisers.Artin.Group M)
  (hex :
    ∃ n,
      (fun n =>
          ∃ a r b,
            a ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M J ∧
              r ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M Set.univ ∧
                b ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M J ∧
                  p = a * r * b ∧ (ArtinNormalisers.Ribbon2.degree M r).toNat = n)
        n)
  (r : ArtinNormalisers.Artin.Group M),
  (ArtinNormalisers.Ribbon2.degree M r).toNat = Nat.find hex →
    ∀ (s : ArtinNormalisers.Artin.Group M),
      (fun n =>
            ∃ a r b,
              a ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M J ∧
                r ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M Set.univ ∧
                  b ∈ ArtinNormalisers.Ribbon2.actualPositiveParabolic M J ∧
                    p = a * r * b ∧ (ArtinNormalisers.Ribbon2.degree M r).toNat = n)
          (ArtinNormalisers.Ribbon2.degree M s).toNat →
        Nat.find hex ≤ (ArtinNormalisers.Ribbon2.degree M s).toNat →
          0 ≤ ArtinNormalisers.Ribbon2.degree M s →
            ArtinNormalisers.Ribbon2.degree M r = ArtinNormalisers.Ribbon2.degree M s + 1 → False
PROJECT_DECL_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"module":"ArtinRibbons.ParabolicReduction","name":"ArtinNormalisers.Ribbon2.exists_positive_parabolic_double_reduction._proof_1_2"}
