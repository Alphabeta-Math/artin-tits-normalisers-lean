              ⋯) →
          (∀ {X Y Z : ArtinNormalisers.Ribbon2.RibbonObject M} (p : ArtinNormalisers.Ribbon2.AtomicWord M X Y)
              {q r : ArtinNormalisers.Ribbon2.AtomicWord M Y Z} (a : ArtinNormalisers.Ribbon2.AtomicRelation M q r),
              motive (p.append q) (p.append r) ⋯) →
            (∀ {X Y Z : ArtinNormalisers.Ribbon2.RibbonObject M} {p q : ArtinNormalisers.Ribbon2.AtomicWord M X Y}
                (a : ArtinNormalisers.Ribbon2.AtomicRelation M p q) (r : ArtinNormalisers.Ribbon2.AtomicWord M Y Z),
