import ArtinRibbons.PositiveReindex
import OAI.Topology.ArtinGroups.Cancellation.SphericalPositiveCancelMonoid
import TauCeti.GroupTheory.Coxeter.Geometric.Basic

/-! # Spherical positive embedding in the actual parent Artin group

The upstream spherical endpoint is on a restricted matrix and a small,
ordered finite index type. Explicit generator-preserving maps remove the
universal-set subtype and transport the proof through `Fin n`. Thus the
result here allows index types in arbitrary universes.
-/

namespace ArtinNormalisers.Ribbon2

open OAI.HarmonicArtin OAI.HarmonicArtin.CoxeterExchange

private theorem positiveToParent_injective_typeZero {S : Type} [Fintype S] [LinearOrder S]
    (M : CoxeterMatrix S) [Finite M.Group] : Function.Injective (positiveToParent M) := by
  have hT : IsSpherical M Set.univ := by
    unfold IsSpherical
    infer_instance
  have hinj : Function.Injective (positiveToParent (restrictedMatrix M Set.univ)) := by
    intro a b hab
    apply spherical_positiveToArtin_injective M Set.univ hT
    apply (presentationEquiv (restrictedMatrix M Set.univ)).injective
    exact hab
  exact positiveToParent_injective_of_labels M (restrictedMatrix M Set.univ)
    (Equiv.Set.univ S).symm (fun _ _ => rfl) hinj

variable {I : Type*}

/-- The actual positive presentation embeds in the unchanged parent Artin
group for every spherical Coxeter matrix, in any index universe. -/
theorem positiveToParent_injective (M : CoxeterMatrix I) [Finite M.Group] :
    Function.Injective (positiveToParent M) := by
  classical
  let : Finite I := Finite.of_injective M.toCoxeterSystem.simple
    M.toCoxeterSystem.simple_injective
  let : Fintype I := Fintype.ofFinite I
  let e : I ≃ Fin (Fintype.card I) := Fintype.equivFin I
  let N : CoxeterMatrix (Fin (Fintype.card I)) := M.reindex e
  let : Finite N.Group := Finite.of_equiv M.Group (M.reindexGroupEquiv e).symm.toEquiv
  exact positiveToParent_injective_of_labels M N e
    (by intro i j; simp [N, CoxeterMatrix.reindex_apply])
    (positiveToParent_injective_typeZero N)

/-- The positive image is exactly the actual submonoid generated by all
standard generators. -/
theorem positiveToParent_mrange_eq_actual (M : CoxeterMatrix I) :
    MonoidHom.mrange (positiveToParent M) = actualPositiveParabolic M Set.univ := by
  simpa only [actualPositiveParabolic, Set.image_univ] using positiveToParent_mrange M

/-- The canonical map with codomain restricted to its actual positive image. -/
def positiveActualHom (M : CoxeterMatrix I) :
    PositiveArtin M →* actualPositiveParabolic M Set.univ where
  toFun a := ⟨positiveToParent M a, by
    rw [← positiveToParent_mrange_eq_actual]
    exact ⟨a, rfl⟩⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' a b := Subtype.ext (map_mul _ a b)

@[simp] theorem coe_positiveActualHom (M : CoxeterMatrix I) (a : PositiveArtin M) :
    (positiveActualHom M a : Artin.Group M) = positiveToParent M a := rfl

/-- The positive presentation is canonically isomorphic to the actual positive
submonoid. Its underlying map is the canonical generator map. -/
noncomputable def positiveActualEquiv (M : CoxeterMatrix I) [Finite M.Group] :
    PositiveArtin M ≃* actualPositiveParabolic M Set.univ :=
  MulEquiv.ofBijective (positiveActualHom M) ⟨
    fun _ _ h => positiveToParent_injective M (congrArg Subtype.val h), by
      intro a
      have ha : (a : Artin.Group M) ∈ MonoidHom.mrange (positiveToParent M) := by
        simpa only [positiveToParent_mrange_eq_actual] using a.property
      obtain ⟨b, hb⟩ := ha
      exact ⟨b, Subtype.ext hb⟩⟩

@[simp] theorem coe_positiveActualEquiv (M : CoxeterMatrix I) [Finite M.Group]
    (a : PositiveArtin M) :
    (positiveActualEquiv M a : Artin.Group M) = positiveToParent M a := rfl

@[simp] theorem positiveActualEquiv_generator (M : CoxeterMatrix I) [Finite M.Group] (i : I) :
    (positiveActualEquiv M (positiveGenerator M i) : Artin.Group M) =
      Artin.generator M i := positiveToParent_generator M i

/-- An equivalent range formulation of the spherical positive embedding. -/
noncomputable def positiveMrangeEquiv (M : CoxeterMatrix I) [Finite M.Group] :
    PositiveArtin M ≃* MonoidHom.mrange (positiveToParent M) :=
  MulEquiv.ofBijective (positiveToParent M).mrangeRestrict
    ⟨fun _ _ h => positiveToParent_injective M (congrArg Subtype.val h),
      (positiveToParent M).mrangeRestrict_surjective⟩

end ArtinNormalisers.Ribbon2
