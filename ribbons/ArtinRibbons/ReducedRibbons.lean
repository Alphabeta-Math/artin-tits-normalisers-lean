import ArtinRibbons.Fundamental
import Mathlib.CategoryTheory.Groupoid.Subgroupoid

/-!
# The actual subgroupoid generated by outside elementary ribbons

Arrow labels remain elements of the unchanged Artin group. Generation is
finite composition and inversion of the actual ratios of parabolic longest
lifts, together with identities. No normalizer quotient appears in this
definition. The canonical map to that quotient is constructed afterwards;
bijectivity is a separate theorem, not a field of the construction.
-/

namespace ArtinNormalisers.Ribbon2

open CategoryTheory

variable {I : Type*} (M : CoxeterMatrix I) [Finite M.Group]

/-- Finite generation by the actual outside `Δ_J⁻¹ Δ_(J+a)` morphisms.
The ribbon condition supplies the arrow's endpoints. Every outside ratio
must separately be proved to have its actual endpoint; none is postulated. -/
inductive ReducedArrow : RibbonObject M → RibbonObject M → Artin.Group M → Prop
  | identity (X) : ReducedArrow X X 1
  | elementary {X Y} (a : I) (ha : a ∉ X.indices)
      (hr : IsRibbon M X Y (elementaryMu M X.indices a)) :
      ReducedArrow X Y (elementaryMu M X.indices a)
  | comp {X Y Z} {β γ} (hβ : ReducedArrow X Y β) (hγ : ReducedArrow Y Z γ) :
      ReducedArrow X Z (β * γ)
  | inverse {X Y} {β} (hβ : ReducedArrow X Y β) : ReducedArrow Y X β⁻¹

/-- Generated arrows satisfy the literal positive-parabolic transport condition. -/
theorem ReducedArrow.isRibbon {X Y : RibbonObject M} {β : Artin.Group M}
    (h : ReducedArrow M X Y β) : IsRibbon M X Y β := by
  induction h with
  | identity X => exact isRibbon_one M X
  | elementary a ha hr => exact hr
  | comp hβ hγ ihβ ihγ => exact ihβ.mul M ihγ
  | inverse hβ ihβ => exact ihβ.inv M

/-- The actual generated subgroupoid, with all identities retained. -/
def reducedRibbonSubgroupoid : Subgroupoid (RibbonObject M) where
  arrows X Y := {f | ReducedArrow M X Y f.val}
  inv hf := ReducedArrow.inverse hf
  mul hf _ hg := ReducedArrow.comp hf hg

theorem reducedRibbon_identity (X : RibbonObject M) :
    𝟙 X ∈ (reducedRibbonSubgroupoid M).arrows X X :=
  ReducedArrow.identity X

/-- Every object is present, even when it has no outside generators. -/
theorem reducedRibbonSubgroupoid_objs :
    (reducedRibbonSubgroupoid M).objs = Set.univ := by
  ext X
  simp only [Set.mem_univ, iff_true]
  exact ⟨𝟙 X, reducedRibbon_identity M X⟩

/-- Every generated arrow has associate source and target in the original
Coxeter sense; paths from `J` remain in its associate component. -/
theorem ReducedArrow.parabolicAssociate {X Y : RibbonObject M} {β : Artin.Group M}
    (h : ReducedArrow M X Y β) : ParabolicAssociate M X.indices Y.indices :=
  h.isRibbon.parabolicAssociate M

/-- The vertex group as a literal subgroup of the actual Artin group,
using ordinary Artin multiplication, as in the article. -/
def reducedRibbonLoops (X : RibbonObject M) : Subgroup (Artin.Group M) where
  carrier := {β | ReducedArrow M X X β}
  one_mem' := ReducedArrow.identity X
  mul_mem' := ReducedArrow.comp
  inv_mem' := ReducedArrow.inverse

theorem reducedRibbonLoops_le_ribbonLoops (X : RibbonObject M) :
    reducedRibbonLoops M X ≤ ribbonLoops M X :=
  fun _ h => h.isRibbon

theorem reducedRibbonLoop_mem_normalizer (X : RibbonObject M)
    (β : reducedRibbonLoops M X) :
    (β : Artin.Group M) ∈
      Subgroup.normalizer (Artin.parabolic M X.indices : Set (Artin.Group M)) :=
  ribbonLoop_mem_normalizer M X ⟨β.val, β.property.isRibbon⟩

/-- Canonical inclusion of actual generated ribbon labels. -/
def reducedRibbonLoopsToNormalizer (X : RibbonObject M) :
    reducedRibbonLoops M X →*
      Subgroup.normalizer (Artin.parabolic M X.indices : Set (Artin.Group M)) where
  toFun β := ⟨β.val, reducedRibbonLoop_mem_normalizer M X β⟩
  map_one' := rfl
  map_mul' _ _ := rfl

theorem reducedRibbonLoopsToNormalizer_injective (X : RibbonObject M) :
    Function.Injective (reducedRibbonLoopsToNormalizer M X) := by
  intro β γ h
  apply Subtype.ext
  exact congrArg (fun z : Subgroup.normalizer
    (Artin.parabolic M X.indices : Set (Artin.Group M)) => (z : Artin.Group M)) h

/-- The canonical quotient map on actual reduced ribbon loops. Its
injectivity/surjectivity are not assumed by any construction here. -/
def reducedRibbonQuotientMap (X : RibbonObject M) :
    reducedRibbonLoops M X →* Artin.normalizerQuotient M X.indices :=
  (QuotientGroup.mk' ((Artin.parabolic M X.indices).subgroupOf
    (Subgroup.normalizer (Artin.parabolic M X.indices : Set (Artin.Group M))))).comp
      (reducedRibbonLoopsToNormalizer M X)

theorem reducedRibbonQuotientMap_eq_one_iff (X : RibbonObject M)
    (β : reducedRibbonLoops M X) :
    reducedRibbonQuotientMap M X β = 1 ↔ (β : Artin.Group M) ∈ Artin.parabolic M X.indices :=
  QuotientGroup.eq_one_iff (reducedRibbonLoopsToNormalizer M X β)

/-- Positive generated paths, before inverses are allowed. -/
inductive PositiveReducedArrow : RibbonObject M → RibbonObject M → Artin.Group M → Prop
  | identity (X) : PositiveReducedArrow X X 1
  | elementary {X Y} (a : I) (ha : a ∉ X.indices)
      (hr : IsRibbon M X Y (elementaryMu M X.indices a)) :
      PositiveReducedArrow X Y (elementaryMu M X.indices a)
  | comp {X Y Z} {β γ}
      (hβ : PositiveReducedArrow X Y β) (hγ : PositiveReducedArrow Y Z γ) :
      PositiveReducedArrow X Z (β * γ)

theorem PositiveReducedArrow.toReducedArrow {X Y : RibbonObject M} {β : Artin.Group M}
    (h : PositiveReducedArrow M X Y β) : ReducedArrow M X Y β := by
  induction h with
  | identity X => exact .identity X
  | elementary a ha hr => exact .elementary a ha hr
  | comp hβ hγ ihβ ihγ => exact .comp ihβ ihγ

end ArtinNormalisers.Ribbon2
