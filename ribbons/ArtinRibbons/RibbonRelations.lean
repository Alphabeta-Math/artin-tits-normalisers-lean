import ArtinRibbons.RibbonLcm

/-!
# Pair-lcm relations on actual atomic words

One pair of factorizations of each actual pair-lcm is chosen from the proved
existence theorem. The primitive relation equates those two words only.
Reflexivity, symmetry, transitivity and composable word contexts generate
the resulting relation. Equality of arbitrary evaluations is a conclusion
of completeness, not a primitive relation.

The chosen pair need not yet be identified with the article's two specific
standard paths. That distinguished-path identification is separate from the
positive presentation proved here.
-/

set_option autoImplicit false

namespace ArtinNormalisers.Ribbon2

variable {I : Type*} (M : CoxeterMatrix I) [Finite M.Group]

noncomputable def pairAtomicTarget (X : RibbonObject M) (a b : I) : RibbonObject M :=
  ⟨parabolicTwistImage M (insert b (insert a X.indices)) X.indices⟩

/-- A fixed left factorization, chosen after proving actual lcm existence. -/
noncomputable def chosenLcmLeftTail (X : RibbonObject M) (a b : I)
    (ha : a ∉ X.indices) (hb : b ∉ X.indices) (hab : a ≠ b) :
    AtomicWord M (atomicNext M X a) (pairAtomicTarget M X a b) :=
  Classical.choose (pairRibbonLcm_atomicWords M X.indices a b ha hb hab)

/-- The corresponding fixed right factorization of the same actual lcm. -/
noncomputable def chosenLcmRightTail (X : RibbonObject M) (a b : I)
    (ha : a ∉ X.indices) (hb : b ∉ X.indices) (hab : a ≠ b) :
    AtomicWord M (atomicNext M X b) (pairAtomicTarget M X a b) :=
  Classical.choose (Classical.choose_spec (pairRibbonLcm_atomicWords M X.indices a b ha hb hab))

theorem chosenLcmLeft_eval (X : RibbonObject M) (a b : I)
    (ha : a ∉ X.indices) (hb : b ∉ X.indices) (hab : a ≠ b) :
    (AtomicWord.cons a ha (chosenLcmLeftTail M X a b ha hb hab)).eval =
      pairRibbonLcm M X.indices a b :=
  (Classical.choose_spec (Classical.choose_spec
    (pairRibbonLcm_atomicWords M X.indices a b ha hb hab))).1

theorem chosenLcmRight_eval (X : RibbonObject M) (a b : I)
    (ha : a ∉ X.indices) (hb : b ∉ X.indices) (hab : a ≠ b) :
    (AtomicWord.cons b hb (chosenLcmRightTail M X a b ha hb hab)).eval =
      pairRibbonLcm M X.indices a b :=
  (Classical.choose_spec (Classical.choose_spec
    (pairRibbonLcm_atomicWords M X.indices a b ha hb hab))).2

/-- The congruence generated by fixed actual pair-lcm words. -/
inductive AtomicRelation : {X Y : RibbonObject M} → AtomicWord M X Y → AtomicWord M X Y → Prop
  | refl {X Y} (p : AtomicWord M X Y) : AtomicRelation p p
  | symm {X Y} {p q : AtomicWord M X Y} : AtomicRelation p q → AtomicRelation q p
  | trans {X Y} {p q r : AtomicWord M X Y} :
      AtomicRelation p q → AtomicRelation q r → AtomicRelation p r
  | lcm (X : RibbonObject M) (a b : I) (ha : a ∉ X.indices) (hb : b ∉ X.indices) (hab : a ≠ b) :
      AtomicRelation
        (.cons a ha (chosenLcmLeftTail M X a b ha hb hab))
        (.cons b hb (chosenLcmRightTail M X a b ha hb hab))
  | precontext {X Y Z} (p : AtomicWord M X Y) {q r : AtomicWord M Y Z} :
      AtomicRelation q r → AtomicRelation (p.append q) (p.append r)
  | postcontext {X Y Z} {p q : AtomicWord M X Y} : AtomicRelation p q →
      (r : AtomicWord M Y Z) → AtomicRelation (p.append r) (q.append r)

namespace AtomicRelation

variable {M}

theorem cons {X Y : RibbonObject M} (a : I) (ha : a ∉ X.indices)
    {p q : AtomicWord M (atomicNext M X a) Y} (h : AtomicRelation M p q) :
    AtomicRelation M (.cons a ha p) (.cons a ha q) :=
  .precontext (.cons a ha (.nil _)) h

theorem eval_eq {X Y : RibbonObject M} {p q : AtomicWord M X Y}
    (h : AtomicRelation M p q) : p.eval = q.eval := by
  induction h with
  | refl p => rfl
  | symm h ih => exact ih.symm
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂
  | lcm X a b ha hb hab =>
    exact (chosenLcmLeft_eval M X a b ha hb hab).trans
      (chosenLcmRight_eval M X a b ha hb hab).symm
  | precontext p h ih => simp only [AtomicWord.eval_append, ih]
  | postcontext h r ih => simp only [AtomicWord.eval_append, ih]

end AtomicRelation

/-- A positive ribbon left factor leaves a positive generated ribbon tail
when the full product is source-left-reduced. -/
theorem positive_ribbon_factor_tail {X Z Y : RibbonObject M} {l r s : Artin.Group M}
    (hlpos : l ∈ actualPositiveParabolic M Set.univ) (hl : IsRibbon M X Z l)
    (hrred : IsLeftParabolicallyReduced M X.indices r) (hr : IsRibbon M X Y r)
    (hspos : s ∈ actualPositiveParabolic M Set.univ) (hfac : r = l * s) :
    PositiveReducedArrow M Z Y s := by
  have hsr : IsRibbon M Z Y s := by
    have h := (hl.inv M).mul M hr
    have he : l⁻¹ * r = s := by rw [hfac]; group
    simpa only [he] using h
  have hsred : IsLeftParabolicallyReduced M Z.indices s := by
    intro j hj t ht he
    obtain ⟨i, hi, hrel⟩ := IsRibbon.generator_reverse M hl hj
    apply hrred i hi (l * t) ((actualPositiveParabolic M Set.univ).mul_mem hlpos ht)
    rw [← mul_assoc, hrel, mul_assoc, he]
    exact hfac.symm
  exact positive_leftReduced_ribbon_generated M hspos hsred hsr

/-- All equal evaluations of positive atomic words follow from the fixed
pair-lcm relations. The proof descends on the actual positive exponent sum,
using cancellation at a common first atom and an actual lcm otherwise. -/
theorem atomicRelation_of_eval_eq {X Y : RibbonObject M} (p q : AtomicWord M X Y)
    (he : p.eval = q.eval) : AtomicRelation M p q := by
  have core : ∀ n (X Y : RibbonObject M) (p q : AtomicWord M X Y),
      (degree M p.eval).toNat = n → p.eval = q.eval → AtomicRelation M p q := by
    intro n
    induction n using Nat.strong_induction_on with
    | ind n ih =>
      intro X Y p q hn he
      cases p with
      | nil X =>
        cases q with
        | nil X => exact .refl _
        | cons b hb q => exact False.elim (q.cons_eval_ne_one b hb he.symm)
      | cons a ha p =>
        cases q with
        | nil X => exact False.elim (p.cons_eval_ne_one a ha he)
        | cons b hb q =>
          by_cases hab : a = b
          · subst b
            have htail : p.eval = q.eval := mul_left_cancel he
            have hlt := p.degree_tail_lt a ha
            rw [hn] at hlt
            exact .cons a ha (ih _ hlt _ _ p q rfl htail)
          · let L := pairAtomicTarget M X a b
            let l := pairRibbonLcm M X.indices a b
            let u := chosenLcmLeftTail M X a b ha hb hab
            let v := chosenLcmRightTail M X a b ha hb hab
            obtain ⟨s, hspos, hs⟩ := (pairRibbonLcm_is_left_lcm M X.indices a b).2.2
              (AtomicWord.cons a ha p).eval (AtomicWord.cons a ha p).positive
              ⟨p.eval, p.positive, rfl⟩ ⟨q.eval, q.positive, he⟩
            have hsgen : PositiveReducedArrow M L Y s := positive_ribbon_factor_tail M
              (pairRibbonLcm_positive M X.indices a b) (pairRibbonLcm_isRibbon M X.indices a b)
              (AtomicWord.cons a ha p).leftReduced (AtomicWord.cons a ha p).isRibbon hspos hs
            let t := hsgen.atomicWord M
            have ht : t.eval = s := hsgen.atomicWord_eval M
            have hu : elementaryMu M X.indices a * u.eval = l := chosenLcmLeft_eval M X a b ha hb hab
            have hv : elementaryMu M X.indices b * v.eval = l := chosenLcmRight_eval M X a b ha hb hab
            have hp : p.eval = (u.append t).eval := by
              apply mul_left_cancel (a := elementaryMu M X.indices a)
              rw [AtomicWord.eval_append, ← mul_assoc, hu, ht]
              exact hs
            have hq : q.eval = (v.append t).eval := by
              apply mul_left_cancel (a := elementaryMu M X.indices b)
              rw [AtomicWord.eval_append, ← mul_assoc, hv, ht]
              exact he.symm.trans hs
            have hltp := p.degree_tail_lt a ha
            rw [hn] at hltp
            have hltq := q.degree_tail_lt b hb
            rw [← he, hn] at hltq
            have hpRel := ih _ hltp _ _ p (u.append t) rfl hp
            have hqRel := ih _ hltq _ _ q (v.append t) rfl hq
            exact .trans (.cons a ha hpRel)
              (.trans (.postcontext (.lcm X a b ha hb hab) t) (.symm (.cons b hb hqRel)))
  exact core _ X Y p q rfl he

theorem atomicRelation_iff_eval_eq {X Y : RibbonObject M} (p q : AtomicWord M X Y) :
    AtomicRelation M p q ↔ p.eval = q.eval :=
  ⟨AtomicRelation.eval_eq, atomicRelation_of_eval_eq M p q⟩

/-- The setoid is generated by the fixed lcm relations, rather than defined
to identify all words with equal evaluation. -/
def atomicRelationSetoid (X Y : RibbonObject M) : Setoid (AtomicWord M X Y) where
  r := AtomicRelation M
  iseqv := ⟨AtomicRelation.refl, AtomicRelation.symm, AtomicRelation.trans⟩

/-- Formal positive morphisms presented by actual atoms and the fixed
pair-lcm relations. -/
def PositiveAtomicHom (X Y : RibbonObject M) := Quotient (atomicRelationSetoid M X Y)

/-- Evaluation descends by soundness of the primitive lcm relations. -/
noncomputable def positiveAtomicHomEval (X Y : RibbonObject M) :
    PositiveAtomicHom M X Y → {r : Artin.Group M // PositiveReducedArrow M X Y r} :=
  Quotient.lift (fun p => ⟨p.eval, p.toPositiveReducedArrow⟩)
    (fun _ _ h => Subtype.ext h.eval_eq)

theorem positiveAtomicHomEval_injective (X Y : RibbonObject M) :
    Function.Injective (positiveAtomicHomEval M X Y) := by
  refine Quotient.ind₂ ?_
  intro p q h
  apply Quotient.sound
  exact atomicRelation_of_eval_eq M p q (congrArg Subtype.val h)

theorem positiveAtomicHomEval_surjective (X Y : RibbonObject M) :
    Function.Surjective (positiveAtomicHomEval M X Y) := by
  rintro ⟨r, hr⟩
  obtain ⟨p, hp⟩ := (positiveReducedArrow_iff_exists_atomicWord M).mp hr
  exact ⟨Quotient.mk _ p, Subtype.ext hp⟩

/-- A genuine presentation of the actual positive generated morphism set:
surjectivity uses positive atomic generation and injectivity uses the proved
lcm-relation completeness theorem. -/
noncomputable def positiveAtomicHomEquiv (X Y : RibbonObject M) :
    PositiveAtomicHom M X Y ≃ {r : Artin.Group M // PositiveReducedArrow M X Y r} :=
  Equiv.ofBijective (positiveAtomicHomEval M X Y)
    ⟨positiveAtomicHomEval_injective M X Y, positiveAtomicHomEval_surjective M X Y⟩

end ArtinNormalisers.Ribbon2
