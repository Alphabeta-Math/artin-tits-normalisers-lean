import ArtinRibbons.Presentation
import OAI.Topology.ArtinGroups.Harmonic.PositiveDegreeHom

/-! # Actual positive submonoids and their canonical presentation map

Image and generation statements here do not assume or assert injectivity of
the positive presentation into the Artin group.
-/

namespace ArtinNormalisers.Ribbon2

variable {I : Type*}

/-- The actual monoid generated by the selected standard Artin generators. -/
def actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I) : Submonoid (Artin.Group M) :=
  Submonoid.closure (Artin.generator M '' J)

theorem generator_mem_actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I)
    {i : I} (hi : i ∈ J) : Artin.generator M i ∈ actualPositiveParabolic M J :=
  Submonoid.subset_closure ⟨i, hi, rfl⟩

theorem actualPositiveParabolic_le_parabolic (M : CoxeterMatrix I) (J : Set I) :
    actualPositiveParabolic M J ≤ (Artin.parabolic M J).toSubmonoid := by
  apply Submonoid.closure_le.mpr
  intro a ha
  exact Subgroup.subset_closure ha

/-- Group generation of the actual positive parabolic recovers the actual
standard Artin parabolic. -/
theorem subgroupClosure_actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I) :
    Subgroup.closure (actualPositiveParabolic M J : Set (Artin.Group M)) =
      Artin.parabolic M J := by
  apply le_antisymm
  · exact (Subgroup.closure_le _).mpr (actualPositiveParabolic_le_parabolic M J)
  · apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, hi, rfl⟩
    exact Subgroup.subset_closure (generator_mem_actualPositiveParabolic M J hi)

theorem wordProd_mem_actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I)
    (w : List I) (hw : ∀ i ∈ w, i ∈ J) : Artin.wordProd M w ∈ actualPositiveParabolic M J := by
  induction w with
  | nil => exact Submonoid.one_mem _
  | cons i w ih =>
    change Artin.generator M i * Artin.wordProd M w ∈ _
    exact Submonoid.mul_mem _ (generator_mem_actualPositiveParabolic M J (hw i (by simp)))
      (ih (fun j hj => hw j (List.mem_cons_of_mem i hj)))

/-- The canonical map from the actual OAI positive presentation to the
unchanged parent Artin group. -/
def positiveToParent (M : CoxeterMatrix I) : OAI.HarmonicArtin.PositiveArtin M →* Artin.Group M :=
  (presentationEquiv M).toMonoidHom.comp (OAI.HarmonicArtin.positiveToArtin M)

@[simp] theorem positiveToParent_generator (M : CoxeterMatrix I) (i : I) :
    positiveToParent M (OAI.HarmonicArtin.positiveGenerator M i) = Artin.generator M i := by
  simp [positiveToParent]

@[simp] theorem positiveToParent_word (M : CoxeterMatrix I) (w : List I) :
    positiveToParent M (OAI.HarmonicArtin.wordPositive M w) = Artin.wordProd M w := by
  simp [positiveToParent]

theorem positive_word_surjective (M : CoxeterMatrix I) (a : OAI.HarmonicArtin.PositiveArtin M) :
    ∃ w : List I, OAI.HarmonicArtin.wordPositive M w = a := by
  obtain ⟨w, rfl⟩ := PresentedMonoid.surjective_mk a
  exact ⟨FreeMonoid.toList w, by rw [OAI.HarmonicArtin.wordPositive_mk, FreeMonoid.ofList_toList]⟩

/-- Its monoid image is exactly the positive monoid on all standard
generators. This does not assert that this map is injective. -/
theorem positiveToParent_mrange (M : CoxeterMatrix I) :
    MonoidHom.mrange (positiveToParent M) = Submonoid.closure (Set.range (Artin.generator M)) := by
  rw [← FreeMonoid.mrange_lift (Artin.generator M)]
  ext a
  constructor
  · rintro ⟨b, rfl⟩
    obtain ⟨w, rfl⟩ := positive_word_surjective M b
    exact ⟨FreeMonoid.ofList w, by simp [Artin.wordProd]⟩
  · rintro ⟨w, rfl⟩
    exact ⟨OAI.HarmonicArtin.wordPositive M (FreeMonoid.toList w), by
      simp [Artin.wordProd, ← FreeMonoid.lift_ofList]⟩

/-- The selected-generator image is the corresponding actual positive
parabolic, without a positive-embedding premise. -/
theorem map_positiveParabolic (M : CoxeterMatrix I) (J : Set I) :
    (Submonoid.closure (OAI.HarmonicArtin.positiveGenerator M '' J)).map (positiveToParent M) =
      actualPositiveParabolic M J := by
  rw [MonoidHom.map_mclosure, actualPositiveParabolic, Set.image_image]
  congr 1

/-- The ambient exponent sum is defined directly on the actual group, not
by choosing a positive preimage. -/
abbrev exponentSum (M : CoxeterMatrix I) : Artin.Group M →* Multiplicative ℤ :=
  TauCeti.ArtinGroup.exponentSum M

def degree (M : CoxeterMatrix I) (a : Artin.Group M) : ℤ :=
  Multiplicative.toAdd (exponentSum M a)

@[simp] theorem degree_one (M : CoxeterMatrix I) : degree M 1 = 0 := by
  simp [degree]

@[simp] theorem degree_generator (M : CoxeterMatrix I) (i : I) :
    degree M (Artin.generator M i) = 1 := by
  simp [degree, exponentSum, Artin.generator]

theorem degree_mul (M : CoxeterMatrix I) (a b : Artin.Group M) :
    degree M (a * b) = degree M a + degree M b := by
  unfold degree
  rw [map_mul]
  rfl

@[simp] theorem degree_inv (M : CoxeterMatrix I) (a : Artin.Group M) :
    degree M a⁻¹ = -degree M a := by
  unfold degree
  rw [map_inv]
  rfl

@[simp] theorem degree_wordProd (M : CoxeterMatrix I) (w : List I) :
    degree M (Artin.wordProd M w) = (w.length : ℤ) := by
  induction w with
  | nil => exact degree_one M
  | cons i w ih =>
    change degree M (Artin.generator M i * Artin.wordProd M w) = ((i :: w).length : ℤ)
    rw [degree_mul, degree_generator, ih]
    simp [add_comm]

theorem degree_positiveToParent (M : CoxeterMatrix I) (a : OAI.HarmonicArtin.PositiveArtin M) :
    degree M (positiveToParent M a) = (OAI.HarmonicArtin.positiveDegree M a : ℤ) := by
  obtain ⟨w, rfl⟩ := positive_word_surjective M a
  rw [positiveToParent_word, degree_wordProd, OAI.HarmonicArtin.positiveDegree_word]

theorem degree_nonneg_of_mem_actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I)
    {a : Artin.Group M} (ha : a ∈ actualPositiveParabolic M J) : 0 ≤ degree M a := by
  let N : Submonoid (Artin.Group M) :=
    { carrier := {a | 0 ≤ degree M a}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        change 0 ≤ degree M (a * b)
        rw [degree_mul]
        exact add_nonneg ha hb }
  have hle : actualPositiveParabolic M J ≤ N := by
    apply Submonoid.closure_le.mpr
    rintro _ ⟨i, _, rfl⟩
    change 0 ≤ degree M (Artin.generator M i)
    simp
  exact hle ha

/-- On the actual positive monoid, zero exponent sum forces the identity;
this follows from word length and does not require positive injectivity. -/
theorem degree_eq_zero_iff_of_mem_actualPositiveParabolic (M : CoxeterMatrix I) (J : Set I)
    {a : Artin.Group M} (ha : a ∈ actualPositiveParabolic M J) : degree M a = 0 ↔ a = 1 := by
  constructor
  · intro h
    have hfull : a ∈ Submonoid.closure (Set.range (Artin.generator M)) := by
      apply Submonoid.closure_mono (s := Artin.generator M '' J) ?_ ha
      rintro _ ⟨i, _, rfl⟩
      exact ⟨i, rfl⟩
    rw [← positiveToParent_mrange] at hfull
    obtain ⟨b, rfl⟩ := hfull
    have hb : OAI.HarmonicArtin.positiveDegree M b = 0 := by
      rw [degree_positiveToParent] at h
      exact_mod_cast h
    rw [(OAI.HarmonicArtin.positiveDegree_zero_iff M b).mp hb, map_one]
  · rintro rfl
    exact degree_one M

/-- Natural length on an actual positive parabolic, recovered from its
nonnegative ambient exponent sum. -/
def positiveLength (M : CoxeterMatrix I) {J : Set I} (a : actualPositiveParabolic M J) : ℕ :=
  (degree M a.val).toNat

theorem positiveLength_eq_degree (M : CoxeterMatrix I) {J : Set I}
    (a : actualPositiveParabolic M J) : (positiveLength M a : ℤ) = degree M a.val :=
  Int.toNat_of_nonneg (degree_nonneg_of_mem_actualPositiveParabolic M J a.property)

@[simp] theorem positiveLength_one (M : CoxeterMatrix I) (J : Set I) :
    positiveLength M (1 : actualPositiveParabolic M J) = 0 := by
  simp [positiveLength]

theorem positiveLength_mul (M : CoxeterMatrix I) {J : Set I}
    (a b : actualPositiveParabolic M J) : positiveLength M (a * b) =
      positiveLength M a + positiveLength M b := by
  have ha := positiveLength_eq_degree M a
  have hb := positiveLength_eq_degree M b
  have hab := positiveLength_eq_degree M (a * b)
  rw [Submonoid.coe_mul, degree_mul] at hab
  omega

@[simp] theorem positiveLength_generator (M : CoxeterMatrix I) (J : Set I)
    {i : I} (hi : i ∈ J) :
    positiveLength M (⟨Artin.generator M i, generator_mem_actualPositiveParabolic M J hi⟩ :
      actualPositiveParabolic M J) = 1 := by
  simp [positiveLength]

end ArtinNormalisers.Ribbon2
