import ArtinRibbons.NormalizerSplitting
import ArtinRibbons.CoxeterProjection
import ArtinRibbons.RibbonUniversal
import ArtinRibbons.AtomicCoxeter

/-!
# Landmark 2: actual reduced ribbon normalizers and their presentation

The vertex group is the literal subgroup generated by the actual outside
elementary ribbon labels. Its map to the actual normalizer quotient is
proved bijective; the normalizer also has the proved semidirect decomposition.
Fixed chosen actual pair-lcm relations present the generated groupoid.

No identification with a geometric fundamental group or asphericity theorem
is asserted. The specifically distinguished standard-path classification in
the source is not claimed: the complete lcm presentation and the formal
Coxeter length-additivity input give an alternative route for landmark 3.
-/

namespace ArtinNormalisers.Ribbon2

open CategoryTheory

variable {I : Type*} (M : CoxeterMatrix I) [Finite M.Group]

/-- The algebraic normalizer conclusions of landmark 2, for every standard
parabolic, with the original canonical Coxeter projection preserved. -/
theorem landmark_2 (J : Set I) :
    Function.Bijective (reducedRibbonQuotientMap M ⟨J⟩) ∧
      Nonempty (Subgroup.normalizer (Artin.parabolic M J : Set (Artin.Group M)) ≃*
        (Artin.parabolic M J) ⋊[reducedRibbonParabolicAction M ⟨J⟩]
          (reducedRibbonLoops M ⟨J⟩)) ∧
      (Artin.normalizerQuotientMap M J).comp
          (reducedRibbonNormalizerQuotientEquiv M ⟨J⟩).toMonoidHom =
        reducedRibbonCoxeterProjection M ⟨J⟩ :=
  ⟨⟨reducedRibbonQuotientMap_injective M ⟨J⟩,
      reducedRibbonQuotientMap_surjective M ⟨J⟩⟩,
    ⟨normalizerSemidirectEquiv M ⟨J⟩⟩,
    reducedRibbon_projection_compatible M ⟨J⟩⟩

/-- The primitive fixed lcm relations generate every positive word equality. -/
theorem landmark_2_positive_presentation {X Y : RibbonObject M} (p q : AtomicWord M X Y) :
    AtomicRelation M p q ↔ p.eval = q.eval :=
  atomicRelation_iff_eval_eq M p q

/-- The same chosen relations present the actual signed groupoid: every
assignment to any groupoid satisfying only these primitive relations has
exactly one genuine functor extension. -/
theorem landmark_2_groupoid_presentation {C : Type*} [Groupoid C]
    (D : RibbonGeneratorData M C) (hD : D.RespectsLcm) :
    ∃! F : ActualReducedRibbonGroupoid M ⥤ C,
      F.obj = (fun X => D.obj X.val) ∧
      ∀ (X : RibbonObject M) (a : I) (ha : a ∉ X.indices),
        HEq (F.map (actualAtomicHom M X a ha)) (D.atom X a ha) :=
  D.exists_unique_extension hD

end ArtinNormalisers.Ribbon2
