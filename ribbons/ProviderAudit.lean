set_option autoImplicit false
set_option maxHeartbeats 0

#check OAI.HarmonicArtin.spherical_positiveToAmbient_injective
#check OAI.HarmonicArtin.spherical_positiveToArtin_injective
#check OAI.HarmonicArtin.spherical_positive_monoid_fractions
#check OAI.HarmonicArtin.spherical_positive_gcd_left
#check OAI.HarmonicArtin.spherical_positive_gcd_right
#check OAI.HarmonicArtin.spherical_positive_lcm_left
#check OAI.HarmonicArtin.positivePrefix_simple_iff
#check OAI.HarmonicArtin.positive_longest_descent_prefix

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let providers := env.header.moduleNames.filter fun mod => mod.toString.startsWith "OAI."
  unless providers.size == 359 do
    throwError "Expected 359 imported provider modules, found {providers.size}"
  for mod in providers do
    logInfo m!"RIBBON_PROVIDER_MODULE {mod}"
  let mut count : Nat := 0
  for (name, ci) in env.constants.toList do
    if let some idx := env.getModuleIdxFor? name then
      let mod := env.header.moduleNames[idx]!
      if mod.toString.startsWith "OAI." then
        count := count + 1
        let axs ← Lean.collectAxioms name
        for ax in axs do
          unless #[`propext, `Classical.choice, `Quot.sound].contains ax do
            throwError "Forbidden provider axiom {ax} in {name} ({mod})"
        logInfo m!"RIBBON_PROVIDER_TYPE {mod} {name}: {ci.type}"
        logInfo m!"RIBBON_PROVIDER_AXIOMS {mod} {name}: {axs}"
  if count == 0 then throwError "No provider declarations audited"
  logInfo m!"Audited {count} provider declarations; only standard allowed axioms"
