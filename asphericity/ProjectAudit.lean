before source/review freeze. This observer adds no mathematical assumptions.
External canonical ownership is accepted only for identical theorems in known
accepted context/foundations, with its transitive axioms checked here as well.
-/
set_option autoImplicit false
set_option maxHeartbeats 0

private def asphericityProjectReadParts (module : Lean.Name) :
    IO (Array (Lean.ModuleData × Lean.CompactedRegion)) := do
  let file ← Lean.findOLean module
  unless ← file.pathExists do throw <| IO.userError s!"Missing compiled module: {module}"
  let mut files := #[file]
  let server := Lean.OLeanLevel.server.adjustFileName file
  if ← server.pathExists then
    files := files.push server
    let privatePart := Lean.OLeanLevel.private.adjustFileName file
    if ← privatePart.pathExists then files := files.push privatePart
  Lean.readModuleDataParts files

private def asphericityKnownFoundation (module : Lean.Name) : Bool :=
  #["Mathlib", "Init", "Lean", "Std", "Batteries", "Aesop", "Qq"].any
    (fun pfx => module.toString == pfx || module.toString.startsWith (pfx ++ "."))

