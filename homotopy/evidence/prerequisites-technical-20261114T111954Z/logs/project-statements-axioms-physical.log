HOMOTOPY_PROJECT_TYPE ArtinHomotopy.RibbonGcd ArtinNormalisers.Homotopy5.positive_reduced_ribbon_gcd_left._proof_1_2: ∀
  {I : Type u_1} (M : CoxeterMatrix I) [inst : Finite M.Group] {X : ArtinNormalisers.Ribbon2.RibbonObject M}
  {p q : ArtinNormalisers.Artin.Group M},
  (fun n =>
        ∃ U d,
          ArtinNormalisers.Ribbon2.PositiveReducedArrow M X U d ∧
            ArtinNormalisers.Homotopy5.RibbonPrefix M d p ∧
              ArtinNormalisers.Homotopy5.RibbonPrefix M d q ∧ (ArtinNormalisers.Ribbon2.degree M d).toNat = n)
      0 →
    ∀ (d : ArtinNormalisers.Artin.Group M),
      (ArtinNormalisers.Ribbon2.degree M d).toNat =
