                                    (hb : D.admissible B) (hAn : A.card ≤ n) (hBn : B.card ≤ n) (hAB : A ⊆ B)
                                    (t : ↑unitInterval) (x : ↑(R B)) (z : Convexity.StdSimplex ℝ ↥A),
