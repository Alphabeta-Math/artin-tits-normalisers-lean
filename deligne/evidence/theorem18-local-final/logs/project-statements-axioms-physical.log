  {P : Type u} {Y : Type v} [inst : TopologicalSpace Y] {X : Type w} [inst_1 : TopologicalSpace X]
  {D : ArtinNormalisers.Deligne5.FiniteCarrierData P Y} {R : Finset P → Set X} {hR : Antitone R}
  {f₀ f₁ : ArtinNormalisers.Deligne5.ParameterizedCarrierFamily D R hR}
  (hom : (F : Finset P) → (hne : F.Nonempty) → (hF : D.admissible F) → (f₀.map F hne hF).Homotopy (f₁.map F hne hF))
  (carried :
    ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (t : ↑unitInterval) (x : ↑(R F))
      (z : Convexity.StdSimplex ℝ ↥F), (hom F hne hF) (t, x, z) ∈ D.carrier F)
  (compatible :
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B) (hAB : A ⊆ B)
      (t : ↑unitInterval) (x : ↑(R B)) (z : Convexity.StdSimplex ℝ ↥A),
      (hom B hB hb) (t, x, Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) z) =
        (hom A hA ha) (t, ArtinNormalisers.Deligne5.carrierParameterRestrict hR hAB x, z))
  (hom_1 : (F : Finset P) → (hne : F.Nonempty) → (hF : D.admissible F) → (f₀.map F hne hF).Homotopy (f₁.map F hne hF))
  (carried_1 :
    ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (t : ↑unitInterval) (x : ↑(R F))
      (z : Convexity.StdSimplex ℝ ↥F), (hom_1 F hne hF) (t, x, z) ∈ D.carrier F)
  (compatible_1 :
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B) (hAB : A ⊆ B)
      (t : ↑unitInterval) (x : ↑(R B)) (z : Convexity.StdSimplex ℝ ↥A),
      (hom_1 B hB hb) (t, x, Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) z) =
        (hom_1 A hA ha) (t, ArtinNormalisers.Deligne5.carrierParameterRestrict hR hAB x, z)),
  ({ hom := hom, carried := carried, compatible := compatible } =
      { hom := hom_1, carried := carried_1, compatible := compatible_1 }) =
    (hom = hom_1)
