                      (t : ArtinNormalisers.Deligne5.PartialParameterizedCarrierHomotopy f₀ f₁ n) →
                        ((hom :
                              (F : Finset P) →
                                (hne : F.Nonempty) →
                                  (hF : D.admissible F) → F.card ≤ n → (f₀.map F hne hF).Homotopy (f₁.map F hne hF)) →
                            (carried :
                                ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hn : F.card ≤ n)
                                  (t : ↑unitInterval) (x : ↑(R F)) (z : Convexity.StdSimplex ℝ ↥F),
                                  (hom F hne hF hn) (t, x, z) ∈ D.carrier F) →
                              (compatible :
