DELIGNE_PROJECT_TYPE ArtinDeligne.AcyclicCarrierFamilies ArtinNormalisers.Deligne5.CarrierFamily.mk.injEq: ∀
  {P : Type u} {Y : Type v} [inst : TopologicalSpace Y] {D : ArtinNormalisers.Deligne5.FiniteCarrierData P Y}
  (map : (F : Finset P) → F.Nonempty → D.admissible F → C(Convexity.StdSimplex ℝ ↥F, Y))
  (carried :
    ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (x : Convexity.StdSimplex ℝ ↥F),
      (map F hne hF) x ∈ D.carrier F)
  (compatible :
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B) (hAB : A ⊆ B)
      (x : Convexity.StdSimplex ℝ ↥A),
      (map B hB hb) (Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) x) = (map A hA ha) x)
  (map_1 : (F : Finset P) → F.Nonempty → D.admissible F → C(Convexity.StdSimplex ℝ ↥F, Y))
  (carried_1 :
    ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (x : Convexity.StdSimplex ℝ ↥F),
      (map_1 F hne hF) x ∈ D.carrier F)
  (compatible_1 :
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B) (hAB : A ⊆ B)
      (x : Convexity.StdSimplex ℝ ↥A),
      (map_1 B hB hb) (Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) x) =
        (map_1 A hA ha) x),
  ({ map := map, carried := carried, compatible := compatible } =
      { map := map_1, carried := carried_1, compatible := compatible_1 }) =
    (map = map_1)
