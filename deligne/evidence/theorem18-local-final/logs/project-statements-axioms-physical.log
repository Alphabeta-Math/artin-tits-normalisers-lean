DELIGNE_PROJECT_TYPE ArtinDeligne.AcyclicCarrierFamilies ArtinNormalisers.Deligne5.PartialCarrierHomotopy.mk.noConfusion: {P :
    Type u} →
  {Y : Type v} →
    {inst : TopologicalSpace Y} →
      {D : ArtinNormalisers.Deligne5.FiniteCarrierData P Y} →
        {f₀ f₁ : ArtinNormalisers.Deligne5.CarrierFamily D} →
          {n : ℕ} →
            {P_1 : Sort u_1} →
              {hom :
                  (F : Finset P) →
                    (hne : F.Nonempty) →
                      (hF : D.admissible F) → F.card ≤ n → (f₀.map F hne hF).Homotopy (f₁.map F hne hF)} →
                {carried :
                    ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hn : F.card ≤ n) (t : ↑unitInterval)
                      (x : Convexity.StdSimplex ℝ ↥F), (hom F hne hF hn) (t, x) ∈ D.carrier F} →
                  {compatible :
                      ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B)
                        (hAn : A.card ≤ n) (hBn : B.card ≤ n) (hAB : A ⊆ B) (t : ↑unitInterval)
                        (x : Convexity.StdSimplex ℝ ↥A),
                        (hom B hB hb hBn)
                            (t, Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) x) =
                          (hom A hA ha hAn) (t, x)} →
                    {hom' :
                        (F : Finset P) →
                          (hne : F.Nonempty) →
                            (hF : D.admissible F) → F.card ≤ n → (f₀.map F hne hF).Homotopy (f₁.map F hne hF)} →
                      {carried' :
                          ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hn : F.card ≤ n)
                            (t : ↑unitInterval) (x : Convexity.StdSimplex ℝ ↥F),
                            (hom' F hne hF hn) (t, x) ∈ D.carrier F} →
                        {compatible' :
                            ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A)
                              (hb : D.admissible B) (hAn : A.card ≤ n) (hBn : B.card ≤ n) (hAB : A ⊆ B)
                              (t : ↑unitInterval) (x : Convexity.StdSimplex ℝ ↥A),
                              (hom' B hB hb hBn)
                                  (t, Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) x) =
                                (hom' A hA ha hAn) (t, x)} →
                          { hom := hom, carried := carried, compatible := compatible } =
                              { hom := hom', carried := carried', compatible := compatible' } →
