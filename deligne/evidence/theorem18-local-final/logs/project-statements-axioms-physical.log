    [inst : TopologicalSpace Y] →
      {D : ArtinNormalisers.Deligne5.FiniteCarrierData P Y} →
        {f₀ f₁ : ArtinNormalisers.Deligne5.CarrierFamily D} →
          {n : ℕ} →
            {motive : ArtinNormalisers.Deligne5.PartialCarrierHomotopy D f₀ f₁ n → Sort u_1} →
              (t : ArtinNormalisers.Deligne5.PartialCarrierHomotopy D f₀ f₁ n) →
                ((hom :
                      (F : Finset P) →
                        (hne : F.Nonempty) →
                          (hF : D.admissible F) → F.card ≤ n → (f₀.map F hne hF).Homotopy (f₁.map F hne hF)) →
                    (carried :
                        ∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hn : F.card ≤ n) (t : ↑unitInterval)
                          (x : Convexity.StdSimplex ℝ ↥F), (hom F hne hF hn) (t, x) ∈ D.carrier F) →
                      (compatible :
                          ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A)
                            (hb : D.admissible B) (hAn : A.card ≤ n) (hBn : B.card ≤ n) (hAB : A ⊆ B)
                            (t : ↑unitInterval) (x : Convexity.StdSimplex ℝ ↥A),
                            (hom B hB hb hBn)
