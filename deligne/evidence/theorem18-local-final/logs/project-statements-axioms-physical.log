  (∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hFn : F.card ≤ n + 1) (h : ¬F.card ≤ n),
      (∀ (x : Convexity.StdSimplex ℝ ↥F), ⋯.choose x ∈ D.carrier F) ∧
        ∀ (G : Finset P) (hneG : G.Nonempty) (hG : D.admissible G) (hGn : G.card ≤ n) (hGF : G ⊆ F)
          (x : Convexity.StdSimplex ℝ ↥G),
          ⋯.choose (Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hGF) x) =
            (f.map G hneG hG hGn) x) →
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B)
      (hAn : A.card ≤ n + 1) (hBn : B.card ≤ n + 1) (hAB : A ⊆ B) (x : Convexity.StdSimplex ℝ ↥A),
      (if h : B.card ≤ n then f.map B hB hb h else ⋯.choose)
          (Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hAB) x) =
        (if h : A.card ≤ n then f.map A hA ha h else ⋯.choose) x
