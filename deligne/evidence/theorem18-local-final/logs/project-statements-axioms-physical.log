  {f₀ f₁ : ArtinNormalisers.Deligne5.CarrierFamily D} {n : ℕ}
  (f : ArtinNormalisers.Deligne5.PartialCarrierHomotopy D f₀ f₁ n),
  (∀ (F : Finset P) (hne : F.Nonempty) (hF : D.admissible F) (hFn : F.card ≤ n + 1) (h : ¬F.card ≤ n),
      (∀ (t : ↑unitInterval) (x : Convexity.StdSimplex ℝ ↥F), ⋯.choose (t, x) ∈ D.carrier F) ∧
        ∀ (G : Finset P) (hneG : G.Nonempty) (hG : D.admissible G) (hGn : G.card ≤ n) (hGF : G ⊆ F) (t : ↑unitInterval)
          (x : Convexity.StdSimplex ℝ ↥G),
          ⋯.choose (t, Convexity.StdSimplex.map (ArtinNormalisers.Deligne5.carrierFaceInclusion hGF) x) =
            (f.hom G hneG hG hGn) (t, x)) →
    ∀ {A B : Finset P} (hA : A.Nonempty) (hB : B.Nonempty) (ha : D.admissible A) (hb : D.admissible B)
      (hAn : A.card ≤ n + 1) (hBn : B.card ≤ n + 1) (hAB : A ⊆ B) (t : ↑unitInterval) (x : Convexity.StdSimplex ℝ ↥A),
