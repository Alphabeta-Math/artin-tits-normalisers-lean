  (f : ArtinNormalisers.Deligne5.PartialCarrierFamily D n) (F : Finset P),
  F.Nonempty →
    D.admissible F →
      F.card = n + 1 →
        ∃ g,
          (∀ (x : Convexity.StdSimplex ℝ ↥F), g x ∈ D.carrier F) ∧
            ∀ (G : Finset P) (hneG : G.Nonempty) (hG : D.admissible G) (hGn : G.card ≤ n) (hGF : G ⊆ F)
              (x : Convexity.StdSimplex ℝ ↥G),
