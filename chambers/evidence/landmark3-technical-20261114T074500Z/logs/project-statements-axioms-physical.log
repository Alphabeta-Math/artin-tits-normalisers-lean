  (η : (X : FundamentalGroupoid (ArtinNormalisers.Chamber3.ComplexComplement ℓ)) → F.obj X ≅ G.obj X),
  (∀ (C : ArtinNormalisers.Chamber3.Chamber ℓ) {p q : FundamentalGroupoid (ArtinNormalisers.Chamber3.Tubes.Space C)}
      (f : p ⟶ q),
