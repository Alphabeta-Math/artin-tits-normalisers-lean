          (η ((FundamentalGroupoid.map (ContinuousMap.subtypeVal (ArtinNormalisers.Chamber3.tubeSet C))).obj q)).hom =
        CategoryTheory.CategoryStruct.comp
          (η ((FundamentalGroupoid.map (ContinuousMap.subtypeVal (ArtinNormalisers.Chamber3.tubeSet C))).obj p)).hom
          (G.map ((FundamentalGroupoid.map (ContinuousMap.subtypeVal (ArtinNormalisers.Chamber3.tubeSet C))).map f))) →
    (∀ (p : ArtinNormalisers.Chamber3.ComplexComplement ℓ), ∃ C, ArtinNormalisers.Chamber3.tubeSet C ∈ nhds p) →
      {
          arrows := fun x y =>
