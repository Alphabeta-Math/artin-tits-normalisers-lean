import ArtinRibbons.PositiveRibbons
import ArtinNormalisers.Artin.NormalizerLift

/-!
# Positive lifts of minimal standard-parabolic transporters

The Coxeter arguments generalize the frozen `CoxeterNormalizer` proofs from
normalizers to transporters between two parabolics, using Tau Ceti's actual
minimal representatives and length additivity. In finite type, the two
length-additive generator products have equal canonical positive lifts by
the compiled Matsumoto-based multiplication theorem. The resulting actual
Artin label is a positive source-reduced ribbon, hence is generated by the
actual elementary ribbons of Milestone 2.
-/

namespace ArtinNormalisers.Chamber3

section Coxeter

variable {I W : Type*} [Group W] {M : CoxeterMatrix I} (cs : CoxeterSystem M W)
  {J K : Set I} {d : W}

theorem inverse_parabolic_transporter
    (hd : (cs.parabolic K).map (MulAut.conj d).toMonoidHom = cs.parabolic J) :
    (cs.parabolic J).map (MulAut.conj d⁻¹).toMonoidHom = cs.parabolic K := by
  ext x
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply, inv_inv,
    ← hd, Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
  simp [mul_assoc]

/-- The inverse is minimal for the other actual standard parabolic. -/
theorem minimal_inv_of_parabolic_transporter
    (hd : (cs.parabolic K).map (MulAut.conj d).toMonoidHom = cs.parabolic J)
    (hmin : cs.IsMinimalCosetRep K d) : cs.IsMinimalCosetRep J d⁻¹ := by
  apply cs.isMinimalCosetRep_iff.mpr
  intro i hi hdesc
  have hleft := cs.isRightDescent_inv_iff.mp hdesc
  have hc : d⁻¹ * cs.simple i * d ∈ cs.parabolic K := by
    have hm := cs.simple_mem_parabolic hi
    rw [← hd, Subgroup.mem_map_equiv, MulAut.conj_symm_apply] at hm
    exact hm
  have hlen := cs.length_mul_of_isMinimalCosetRep hmin hc
  have heq : d * (d⁻¹ * cs.simple i * d) = cs.simple i * d := by group
  rw [heq] at hlen
  have hshort := cs.isLeftDescent_iff.mp hleft
  omega

/-- A minimal transporter permutes the selected simple generators between
its two actual standard parabolics. -/
theorem transporter_conjugates_simple
    (hd : (cs.parabolic K).map (MulAut.conj d).toMonoidHom = cs.parabolic J)
    (hmin : cs.IsMinimalCosetRep K d) {i : I} (hi : i ∈ K) :
    ∃ j ∈ J, d * cs.simple i * d⁻¹ = cs.simple j := by
  let c := d * cs.simple i * d⁻¹
  have hc : c ∈ cs.parabolic J := by
    rw [← hd]
    exact ⟨cs.simple i, cs.simple_mem_parabolic hi, rfl⟩
  have hright := cs.length_mul_of_isMinimalCosetRep hmin (cs.simple_mem_parabolic hi)
  have hleft := cs.length_mul_of_isMinimalCosetRep
    (minimal_inv_of_parabolic_transporter cs hd hmin) (inv_mem hc)
  rw [← mul_inv_rev, cs.length_inv, cs.length_inv, cs.length_inv] at hleft
  have heq : c * d = d * cs.simple i := by dsimp [c]; group
  rw [heq] at hleft
  rw [cs.length_simple] at hright
  have hclen : cs.length c = 1 := by omega
  obtain ⟨ω, hred, hJ, hprod⟩ := cs.exists_isReduced_wordProd_eq_of_mem_parabolic hc
  have hlen : ω.length = 1 := by rw [← hred.eq, hprod, hclen]
  obtain ⟨j, rfl⟩ := List.length_eq_one_iff.mp hlen
  exact ⟨j, hJ j (by simp), by simpa only [cs.wordProd_singleton] using hprod.symm⟩

theorem transporter_inverse_conjugates_simple
    (hd : (cs.parabolic K).map (MulAut.conj d).toMonoidHom = cs.parabolic J)
    (hmin : cs.IsMinimalCosetRep K d) {i : I} (hi : i ∈ J) :
    ∃ j ∈ K, d⁻¹ * cs.simple i * d = cs.simple j := by
  simpa only [inv_inv] using transporter_conjugates_simple cs
    (inverse_parabolic_transporter cs hd) (minimal_inv_of_parabolic_transporter cs hd hmin) hi

/-- Choosing the canonical representative in the right parabolic coset
preserves the original transporter equality. -/
theorem minimalCosetRep_transports_parabolic {w : W}
    (hw : (cs.parabolic K).map (MulAut.conj w).toMonoidHom = cs.parabolic J) :
    (cs.parabolic K).map (MulAut.conj (cs.minimalCosetRep K w)).toMonoidHom =
      cs.parabolic J := by
  let d := cs.minimalCosetRep K w
  let v := w⁻¹ * d
  have hv : v ∈ cs.parabolic K := cs.inv_mul_minimalCosetRep_mem K w
  have hnv : (cs.parabolic K).map (MulAut.conj v).toMonoidHom = cs.parabolic K :=
    Subgroup.mem_normalizer_iff_map_conj_eq.mp ((cs.parabolic K).le_normalizer hv)
  have hdeq : d = w * v := by dsimp [v]; group
  have hc : (MulAut.conj d).toMonoidHom =
      (MulAut.conj w).toMonoidHom.comp (MulAut.conj v).toMonoidHom := by
    ext x
    change d * x * d⁻¹ = w * (v * x * v⁻¹) * w⁻¹
    rw [hdeq]
    group
  change (cs.parabolic K).map (MulAut.conj d).toMonoidHom = cs.parabolic J
  rw [hc, ← Subgroup.map_map, hnv, hw]

end Coxeter

open Ribbon2 OAI.HarmonicArtin OAI.HarmonicArtin.CoxeterExchange

variable {I : Type*} (M : CoxeterMatrix I)

/-- The canonical positive simple lift in the unchanged parent Artin group. -/
noncomputable def transporterPositiveLift (d : M.Group) : Artin.Group M :=
  positiveToParent M (positiveSimpleLift M d)

theorem transporterPositiveLift_positive (d : M.Group) :
    transporterPositiveLift M d ∈ actualPositiveParabolic M Set.univ :=
  (positiveActualHom M (positiveSimpleLift M d)).property

@[simp] theorem projection_transporterPositiveLift (d : M.Group) :
    Artin.projection M (transporterPositiveLift M d) = d := projection_positiveSimpleLift M d

/-- The actual canonical projection of any ribbon is its precise Coxeter
transporter, with the same source and target orientation. -/
theorem isRibbon_projection_transporter {J K : Set I} {β : Artin.Group M}
    (h : IsRibbon M ⟨J⟩ ⟨K⟩ β) :
    (Artin.coxeterParabolic M K).map (MulAut.conj (Artin.projection M β)).toMonoidHom =
      Artin.coxeterParabolic M J := by
  ext g
  rw [Subgroup.mem_map_equiv, MulAut.conj_symm_apply]
  exact (h.conjugates_coxeterParabolic M g).symm

private theorem isRibbon_of_two_generator_relations (J K : Set I) (β : Artin.Group M)
    (hf : ∀ i ∈ K, ∃ j ∈ J, β * Artin.generator M i = Artin.generator M j * β)
    (hb : ∀ j ∈ J, ∃ i ∈ K, Artin.generator M j * β = β * Artin.generator M i) :
    IsRibbon M ⟨J⟩ ⟨K⟩ β := by
  have hforward : actualPositiveParabolic M J ≤
      (actualPositiveParabolic M K).comap (MulAut.conj β⁻¹).toMonoidHom := by
    apply Submonoid.closure_le.mpr
    rintro _ ⟨j, hj, rfl⟩
    obtain ⟨i, hi, he⟩ := hb j hj
    change β⁻¹ * Artin.generator M j * (β⁻¹)⁻¹ ∈ actualPositiveParabolic M K
    rw [inv_inv, mul_assoc, he]
    simpa using generator_mem_actualPositiveParabolic M K hi
  have hbackward : actualPositiveParabolic M K ≤
      (actualPositiveParabolic M J).comap (MulAut.conj β).toMonoidHom := by
    apply Submonoid.closure_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨j, hj, he⟩ := hf i hi
    change β * Artin.generator M i * β⁻¹ ∈ actualPositiveParabolic M J
    rw [he, mul_inv_cancel_right]
    exact generator_mem_actualPositiveParabolic M J hj
  intro a
  constructor
  · intro ha
    have h := hforward ha
    change β⁻¹ * a * (β⁻¹)⁻¹ ∈ actualPositiveParabolic M K at h
    simpa only [inv_inv] using h
  · intro ha
    have h := hbackward ha
    change β * (β⁻¹ * a * β) * β⁻¹ ∈ actualPositiveParabolic M J at h
    simpa [mul_assoc] using h

section Spherical

variable [Finite M.Group] {J K : Set I} {d : M.Group}

omit [Finite M.Group] in
private theorem actual_transporter_to_provider
    (hd : (Artin.coxeterParabolic M K).map (MulAut.conj d).toMonoidHom =
      Artin.coxeterParabolic M J) :
    (M.toCoxeterSystem.parabolic K).map (MulAut.conj d).toMonoidHom =
      M.toCoxeterSystem.parabolic J := by
  simpa only [Artin.coxeterParabolic_eq] using hd

/-- Both Coxeter products are length-additive, so their canonical positive
simple lifts obey the same generator relation. -/
theorem transporterPositiveLift_generator_relation
    (hd : (Artin.coxeterParabolic M K).map (MulAut.conj d).toMonoidHom =
      Artin.coxeterParabolic M J)
    (hmin : M.toCoxeterSystem.IsMinimalCosetRep K d) {i j : I} (hi : i ∈ K) (hj : j ∈ J)
    (hij : d * M.simple i = M.simple j * d) :
    transporterPositiveLift M d * Artin.generator M i =
      Artin.generator M j * transporterPositiveLift M d := by
  classical
  let := fundamental_finite_index M
  let := Fintype.ofFinite I
  have hd' := actual_transporter_to_provider M hd
  have hright := M.toCoxeterSystem.length_mul_of_isMinimalCosetRep hmin
    (M.toCoxeterSystem.simple_mem_parabolic hi)
  have hleft := M.toCoxeterSystem.length_mul_of_isMinimalCosetRep
    (minimal_inv_of_parabolic_transporter M.toCoxeterSystem hd' hmin)
    (M.toCoxeterSystem.simple_mem_parabolic hj)
  have hinv : d⁻¹ * M.toCoxeterSystem.simple j = (M.toCoxeterSystem.simple j * d)⁻¹ := by
    rw [mul_inv_rev, M.toCoxeterSystem.inv_simple]
  rw [hinv, M.toCoxeterSystem.length_inv, M.toCoxeterSystem.length_inv] at hleft
  have hleft' : M.toCoxeterSystem.length (M.toCoxeterSystem.simple j * d) =
      M.toCoxeterSystem.length (M.toCoxeterSystem.simple j) + M.toCoxeterSystem.length d := by omega
  have hij' : d * M.toCoxeterSystem.simple i = M.toCoxeterSystem.simple j * d := by
    simpa only [CoxeterMatrix.toCoxeterSystem_simple] using hij
  have he := congrArg (positiveSimpleLift M) hij'
  rw [positiveSimpleLift_mul M d (M.toCoxeterSystem.simple i) hright,
    positiveSimpleLift_mul M (M.toCoxeterSystem.simple j) d hleft',
    positiveSimpleLift_simple, positiveSimpleLift_simple] at he
  have h := congrArg (positiveToParent M) he
  simpa only [map_mul, positiveToParent_generator, transporterPositiveLift] using h

theorem transporterPositiveLift_isRibbon
    (hd : (Artin.coxeterParabolic M K).map (MulAut.conj d).toMonoidHom =
      Artin.coxeterParabolic M J)
    (hmin : M.toCoxeterSystem.IsMinimalCosetRep K d) :
    IsRibbon M ⟨J⟩ ⟨K⟩ (transporterPositiveLift M d) := by
  have hd' := actual_transporter_to_provider M hd
  apply isRibbon_of_two_generator_relations M J K
  · intro i hi
    obtain ⟨j, hj, he⟩ := transporter_conjugates_simple M.toCoxeterSystem hd' hmin hi
    simp only [CoxeterMatrix.toCoxeterSystem_simple] at he
    refine ⟨j, hj, transporterPositiveLift_generator_relation M hd hmin hi hj ?_⟩
    rw [← he]
    simp [mul_assoc]
  · intro j hj
    obtain ⟨i, hi, he⟩ := transporter_inverse_conjugates_simple M.toCoxeterSystem hd' hmin hj
    simp only [CoxeterMatrix.toCoxeterSystem_simple] at he
    refine ⟨i, hi, (transporterPositiveLift_generator_relation M hd hmin hi hj ?_).symm⟩
    rw [← he]
    simp [mul_assoc]

theorem transporterPositiveLift_leftReduced
    (hd : (Artin.coxeterParabolic M K).map (MulAut.conj d).toMonoidHom =
      Artin.coxeterParabolic M J)
    (hmin : M.toCoxeterSystem.IsMinimalCosetRep K d) :
    IsLeftParabolicallyReduced M J (transporterPositiveLift M d) := by
  classical
  let := fundamental_finite_index M
  let := Fintype.ofFinite I
  have hinv := minimal_inv_of_parabolic_transporter M.toCoxeterSystem
    (actual_transporter_to_provider M hd) hmin
  intro i hi q hq he
  rw [← positiveToParent_mrange_eq_actual] at hq
  obtain ⟨q, rfl⟩ := hq
  have hp : PositivePrefix M (positiveSimpleLift M (M.toCoxeterSystem.simple i))
      (positiveSimpleLift M d) := by
    rw [positiveSimpleLift_simple]
    refine ⟨q, positiveToParent_injective M ?_⟩
    simpa only [map_mul, positiveToParent_generator, transporterPositiveLift] using he.symm
  have hweak := (positivePrefix_simple_iff M _ _).mp hp
  have hdesc := M.toCoxeterSystem.isLeftDescent_iff.mpr
    ((weakPrefix_simple_iff M.toCoxeterSystem i d).mp hweak)
  exact (M.toCoxeterSystem.isMinimalCosetRep_iff.mp hinv i hi)
    (M.toCoxeterSystem.isRightDescent_inv_iff.mpr hdesc)

theorem transporterPositiveLift_generated
    (hd : (Artin.coxeterParabolic M K).map (MulAut.conj d).toMonoidHom =
      Artin.coxeterParabolic M J)
    (hmin : M.toCoxeterSystem.IsMinimalCosetRep K d) :
    PositiveReducedArrow M ⟨J⟩ ⟨K⟩ (transporterPositiveLift M d) :=
  positive_leftReduced_ribbon_generated M (transporterPositiveLift_positive M d)
    (transporterPositiveLift_leftReduced M hd hmin) (transporterPositiveLift_isRibbon M hd hmin)

/-- The canonical representative of a transporter coset has the canonical
positive generated ribbon label. -/
theorem canonicalTransporterPositiveLift_generated {w : M.Group}
    (hw : (Artin.coxeterParabolic M K).map (MulAut.conj w).toMonoidHom =
      Artin.coxeterParabolic M J) :
    PositiveReducedArrow M ⟨J⟩ ⟨K⟩
      (transporterPositiveLift M (M.toCoxeterSystem.minimalCosetRep K w)) := by
  apply transporterPositiveLift_generated M
  · have h := minimalCosetRep_transports_parabolic M.toCoxeterSystem
      (actual_transporter_to_provider M hw)
    simpa only [Artin.coxeterParabolic_eq] using h
  · exact M.toCoxeterSystem.isMinimalCosetRep_minimalCosetRep K w

/-- Conversely, left reduction of a canonical simple lift rules out every
source left descent, hence makes its inverse a minimal representative. -/
theorem transporterPositiveLift_inv_minimal_of_leftReduced
    (hred : IsLeftParabolicallyReduced M J (transporterPositiveLift M d)) :
    M.toCoxeterSystem.IsMinimalCosetRep J d⁻¹ := by
  classical
  let := fundamental_finite_index M
  let := Fintype.ofFinite I
  apply M.toCoxeterSystem.isMinimalCosetRep_iff.mpr
  intro i hi hdesc
  have hleft := M.toCoxeterSystem.isRightDescent_inv_iff.mp hdesc
  have hweak := (weakPrefix_simple_iff M.toCoxeterSystem i d).mpr
    (M.toCoxeterSystem.isLeftDescent_iff.mp hleft)
  have hp := (positivePrefix_simple_iff M _ _).mpr hweak
  rw [positiveSimpleLift_simple] at hp
  obtain ⟨q, hq⟩ := hp
  apply hred i hi (positiveToParent M q) (positiveActualHom M q).property
  have he := congrArg (positiveToParent M) hq
  simpa only [map_mul, positiveToParent_generator, transporterPositiveLift] using he.symm

/-- Each actual elementary ratio is itself the canonical simple positive
lift of its actual Coxeter projection. -/
theorem elementaryMu_eq_transporterPositiveLift (J : Set I) (a : I) :
    elementaryMu M J a = transporterPositiveLift M (Artin.projection M (elementaryMu M J a)) := by
  classical
  let := fundamental_finite_index M
  let := Fintype.ofFinite I
  have hp : elementaryMu M J a ∈ actualPositiveParabolic M Set.univ :=
    Submonoid.closure_mono (Set.image_mono (Set.subset_univ (insert a J)))
      (elementaryMu_positive M J a)
  rw [← positiveToParent_mrange_eq_actual] at hp
  obtain ⟨p, hp⟩ := hp
  have hfactor : positiveDelta M J * p = positiveDelta M (insert a J) := by
    apply positiveToParent_injective M
    rw [map_mul, positiveToParent_positiveDelta, positiveToParent_positiveDelta, hp]
    unfold elementaryMu
    group
  have hs := (positive_simple_factors M (positiveDelta M J) p
    (parabolicLongest M (insert a J)) hfactor).2
  have he : transporterPositiveLift M (positiveToCoxeter M p) = elementaryMu M J a := by
    change positiveToParent M (positiveSimpleLift M (positiveToCoxeter M p)) = _
    rw [← hs, hp]
  have hd : positiveToCoxeter M p = Artin.projection M (elementaryMu M J a) := by
    have h := congrArg (Artin.projection M) he
    simpa only [projection_transporterPositiveLift] using h
  rw [← hd]
  exact he.symm

theorem elementaryMu_projection_inverse_minimal (J : Set I) (a : I) :
    M.toCoxeterSystem.IsMinimalCosetRep J (Artin.projection M (elementaryMu M J a))⁻¹ := by
  apply transporterPositiveLift_inv_minimal_of_leftReduced M
  rw [← elementaryMu_eq_transporterPositiveLift]
  exact elementaryMu_leftReduced M J a

/-- The elementary Coxeter label is right-minimal for its actual endpoint,
including the empty/full parabolic edge cases. -/
theorem elementaryMu_projection_minimal (J : Set I) (a : I) :
    M.toCoxeterSystem.IsMinimalCosetRep (parabolicTwistImage M (insert a J) J)
      (Artin.projection M (elementaryMu M J a)) := by
  have hd := actual_transporter_to_provider M
    (isRibbon_projection_transporter M (elementaryMu_isRibbon M J a))
  have h := minimal_inv_of_parabolic_transporter M.toCoxeterSystem
    (inverse_parabolic_transporter M.toCoxeterSystem hd)
    (elementaryMu_projection_inverse_minimal M J a)
  simpa only [inv_inv] using h

end Spherical

end ArtinNormalisers.Chamber3
